{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // Like @repo/design-system, this package ships source rather than build
    // output: the app and the eval harness both import the `.ts` files through
    // the `exports` map, so there is nothing to emit and the resolver has to
    // behave like the bundler that actually consumes it.
    "noEmit": true,
    // The Vitest configs import `vitest.shared.ts` by its real filename: Vite
    // 7 warns about extensionless specifiers under its native config loader.
    "allowImportingTsExtensions": true,
    "declaration": false,
    "declarationMap": false,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // `vitest/globals` matches `test.globals: true` in both Vitest configs.
    // Naming `types` at all switches off automatic `@types/*` inclusion, so
    // `node` has to be listed alongside it.
    "types": ["vitest/globals", "node"],
    "paths": {
      "@repo/agent/*": ["./src/*"]
    }
  },
  "include": ["."],
  "exclude": ["node_modules"]
}
